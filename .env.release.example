# DeepSpace Archive Docker configuration
#
# Copy this file to:
#   .env
#
# Then edit DSA_MEDIA_PATH for your system.

# ------------------------------------------------------------
# Media library
# ------------------------------------------------------------

# Path on the HOST to the root folder containing your archive.
#
# Synology example:
# DSA_MEDIA_PATH=/volume1/Media Files/LADS Archive
#
# Linux example:
# DSA_MEDIA_PATH=/mnt/media/LADS Archive
#
# Windows Docker Desktop example:
# DSA_MEDIA_PATH=Z:/LADS Archive
#
DSA_MEDIA_PATH=/path/to/LADS Archive



# ------------------------------------------------------------
# Persistent application storage
# ------------------------------------------------------------

# These folders contain DeepSpace Archive databases/settings and cache.
# Relative paths are created beside compose.release.yaml.
DSA_DATA_PATH=./docker-data
DSA_CACHE_PATH=./docker-cache


# ------------------------------------------------------------
# Ports
# ------------------------------------------------------------

# Main web interface.
DSA_WEB_PORT=8081

# Optional direct backend/API diagnostics.
DSA_BACKEND_PORT=3001


# ------------------------------------------------------------
# Version
# ------------------------------------------------------------

# Current version:
DSA_VERSION=1.0.0

# After the first stable release, users who want the stable update channel
# can use:
# DSA_VERSION=latest
