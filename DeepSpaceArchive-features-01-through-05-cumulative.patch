+                      )
+                    }
+                  >
+                    {tag.name}
+                  </button>
+                  <span>
+                    {tag.count} use{tag.count === 1 ? '' : 's'}
+                  </span>
+                  <button
+                    type="button"
+                    onClick={() =>
