+
+function parseTags(
+  value: string
+) {
+  return value
+    .split(',')
+    .map(
+      (tag) =>
+        tag.trim()
+    )
+    .filter(Boolean)
+}
+
+
+function describeRules(
+  rules: SmartPlaylistRules
+) {
+  const parts:
+    string[] = []
+
+  if (
+    rules.characters.length > 0
+  ) {
+    parts.push(
+      rules.characters.join(', ')
+    )
+  }
+
+  if (
+    rules.categories.length > 0
+  ) {
+    parts.push(
+      rules.categories.join(', ')
+    )
+  }
+
+  if (
+    rules.tags.length > 0
+  ) {
+    parts.push(
+      `${rules.tagMode === 'all' ? 'all' : 'any'} tags: ${rules.tags.join(', ')}`
+    )
+  }
+
+  if (rules.favoriteOnly) {
+    parts.push('favorites')
+  }
+
+  if (rules.status !== 'any') {
+    parts.push(rules.status)
+  }
+
+  if (rules.minRating) {
+    parts.push(
+      `${rules.minRating}★+`
+    )
+  }
+
+  return parts.length > 0
+    ? parts.join(' · ')
+    : 'All playable media'
+}
+
+
+function SmartPlaylistsPage() {
+  const navigate =
+    useNavigate()
+
+  const {
