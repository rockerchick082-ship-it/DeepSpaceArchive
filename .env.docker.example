# Copy this file to .env.docker and edit the paths.

# ============================================================
# REQUIRED
# ============================================================

# Host path containing Main Story, Memoria, Gallery, etc.
#
# Windows example:
# DSA_MEDIA_PATH=G:/LADS Archive
#
# Synology example:
# DSA_MEDIA_PATH=/volume1/Media/LADS Archive
#
DSA_MEDIA_PATH=G:/LADS Archive


# ============================================================
# OPTIONAL
# ============================================================

# Host folders where DeepSpace Archive stores persistent app data.
DSA_DATA_PATH=./docker-data
DSA_CACHE_PATH=./docker-cache

# Web UI:
# http://localhost:8081
DSA_WEB_PORT=8081

# Direct backend diagnostic port:
# http://localhost:3001/api/health
DSA_BACKEND_PORT=3001
