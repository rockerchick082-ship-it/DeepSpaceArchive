+
+  const [
+    favoriteOnly,
+    setFavoriteOnly,
+  ] = useState(false)
+
+
+  const load =
+    useCallback(
+      async () => {
+        try {
+          setLoading(true)
+          setPlaylists(
+            await fetchSmartPlaylists()
+          )
+          setError('')
+        } catch (
+          loadError
+        ) {
+          setError(
+            loadError instanceof Error
+              ? loadError.message
